<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout ראשי עם תמונת הרקע bg_english
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_english"
    android:padding="24dp">

    <!-- כותרת ראשית: גדולה וממורכזת למעלה -->
    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:text="מסך הבית"
        android:textColor="#1E3A8A"
        android:textSize="150sp"
        android:textStyle="bold" />

    <!-- מיכל הכפתורים: ממורכז בדיוק באמצע המסך -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- כפתור 1: תרגול דקדוק ואוצר מילים -->
        <Button
            android:id="@+id/btnQuiz"
            android:layout_width="600dp"
            android:layout_height="200dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#2563EB"
            android:gravity="center"
            android:padding="8dp"
            android:text="תרגול דקדוק ואוצר מילים"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- כפתור 2: תרגול כתיבת פסקה -->
        <Button
            android:id="@+id/btnWriting"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#2563EB"
            android:gravity="center"
            android:padding="8dp"
            android:text="תרגול כתיבת פסקה"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- כפתור 3: היסטוריה ומעקב -->
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:backgroundTint="#2563EB"
            android:gravity="center"
            android:padding="8dp"
            android:text="היסטוריה ומעקב"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>